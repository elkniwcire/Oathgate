<Window x:Class="SteamNite.WinUI.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Oathgate">
  <Grid x:Name="Root" Background="{StaticResource AppSurface}" RequestedTheme="Dark">
    <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="68"/><RowDefinition Height="32"/></Grid.RowDefinitions>
    <Grid x:Name="DragRegion" Margin="24,0,150,0"><StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><Image Source="oathgate.png" Width="24" Height="24" AutomationProperties.Name="Oathgate icon"/><TextBlock Text="Oathgate" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Text="Bring your games into Steam." FontSize="12" Foreground="{StaticResource QuietText}" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel></Grid>
    <Grid Grid.Row="1" Margin="32,22,32,20">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Spacing="6"><TextBlock Text="Your library" FontSize="32" FontWeight="SemiBold"/><TextBlock x:Name="Summary" Text="Finding your games…" Foreground="{StaticResource QuietText}"/></StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <ProgressRing x:Name="Loading" IsActive="True" Width="20" Height="20" Margin="0,0,8,0"/>
        <Button x:Name="RescanButton" Click="Rescan_Click"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72C;" FontSize="14"/><TextBlock Text="Rescan"/></StackPanel></Button>
        <Button x:Name="MoreButton" Content="More"><Button.Flyout><MenuFlyout><MenuFlyoutItem Text="Manage folders…" Tag="ManageFolders" Click="GlobalWorkflow_Click"/><MenuFlyoutItem Text="Settings…" Tag="Settings" Click="GlobalWorkflow_Click"/><MenuFlyoutItem Text="Activity history…" Tag="History" Click="GlobalWorkflow_Click"/><MenuFlyoutSeparator/><MenuFlyoutItem Text="Recommended artwork for entire library…" Tag="AllArtwork" Click="GlobalWorkflow_Click"/><MenuFlyoutSeparator/><MenuFlyoutItem Text="Scan details" Click="Notices_Click"/><MenuFlyoutItem Text="About Oathgate" Click="About_Click"/></MenuFlyout></Button.Flyout></Button>
      </StackPanel>
    </Grid>
    <Grid Grid.Row="2" Margin="32,0,32,20" ColumnSpacing="14">
      <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <AutoSuggestBox x:Name="Search" PlaceholderText="Search your games" QueryIcon="Find" TextChanged="Search_Changed"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <ToggleButton x:Name="AllChip" Content="All" IsChecked="True" Tag="All" Click="Filter_Click"/>
        <ToggleButton x:Name="AttentionChip" Content="Needs attention" Tag="Attention" Click="Filter_Click"/>
        <ToggleButton x:Name="UnsyncedChip" Content="Not in Steam" Tag="Unsynced" Click="Filter_Click"/>
        <ToggleButton x:Name="ArtworkChip" Content="Missing artwork" Tag="Artwork" Click="Filter_Click"/>
      </StackPanel>
      <Button Grid.Column="2" x:Name="PlatformButton" Content="More filters"><Button.Flyout><MenuFlyout>
        <MenuFlyoutSubItem Text="Library state"><MenuFlyoutItem Text="All" Tag="All" Click="State_Click"/><MenuFlyoutItem Text="Installed" Tag="Installed" Click="State_Click"/><MenuFlyoutItem Text="Not installed" Tag="Not installed" Click="State_Click"/><MenuFlyoutItem Text="Steam only" Tag="Steam only" Click="State_Click"/><MenuFlyoutItem Text="Needs repair" Tag="Needs repair" Click="State_Click"/><MenuFlyoutItem Text="Ignored" Tag="Ignored" Click="State_Click"/></MenuFlyoutSubItem>
        <MenuFlyoutSubItem Text="Platform"><MenuFlyoutItem Text="All platforms" Click="Platform_Click"/><MenuFlyoutItem Text="Xbox" Click="Platform_Click"/><MenuFlyoutItem Text="Epic" Click="Platform_Click"/><MenuFlyoutItem Text="Amazon" Click="Platform_Click"/><MenuFlyoutItem Text="GOG" Click="Platform_Click"/><MenuFlyoutItem Text="Ubisoft" Click="Platform_Click"/><MenuFlyoutItem Text="EA" Click="Platform_Click"/><MenuFlyoutItem Text="Manual" Click="Platform_Click"/></MenuFlyoutSubItem>
        <MenuFlyoutItem Text="Clear all filters" Click="ClearFilters_Click"/>
      </MenuFlyout></Button.Flyout></Button>
    </Grid>
    <Grid Grid.Row="3" Margin="24,0,24,0">
      <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid Margin="8,0,24,0" ColumnSpacing="16">
        <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/><ColumnDefinition Width="140"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
        <CheckBox x:Name="SelectAllCheck" IsThreeState="True" Click="SelectAll_Click" MinWidth="0" Width="32" Padding="0" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="Select all shown games" ToolTipService.ToolTip="Select or clear all games shown by the current filters"/>
        <TextBlock Grid.Column="2" Text="GAME" FontSize="10" VerticalAlignment="Center" Foreground="{StaticResource QuietText}"/>
        <TextBlock Grid.Column="3" Text="INSTALLATION" FontSize="10" VerticalAlignment="Center" Foreground="{StaticResource QuietText}"/>
        <TextBlock Grid.Column="4" Text="STEAM" FontSize="10" VerticalAlignment="Center" Foreground="{StaticResource QuietText}"/>
        <TextBlock Grid.Column="5" Text="ARTWORK" FontSize="10" VerticalAlignment="Center" Foreground="{StaticResource QuietText}"/>
      </Grid>
      <ListView Grid.Row="1" x:Name="GameList" SelectionChanged="Game_Selected" Background="Transparent" BorderThickness="0" SelectionMode="Extended" IsMultiSelectCheckBoxEnabled="False" RightTapped="Game_RightTapped" DoubleTapped="Game_DoubleTapped" HorizontalContentAlignment="Stretch">
        <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,2"/><Setter Property="CornerRadius" Value="8"/></Style></ListView.ItemContainerStyle>
        <ListView.ItemTemplate><DataTemplate>
          <Grid ColumnSpacing="16" MinHeight="56">
            <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/><ColumnDefinition Width="140"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
            <CheckBox IsChecked="{Binding IsSelected, Mode=OneWay}" Click="Game_CheckClicked" MinWidth="0" Width="32" Padding="0" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="{Binding Title}"/>
            <Border Grid.Column="1" Width="36" Height="50" Background="{StaticResource PanelSurface}" CornerRadius="4"><Grid><TextBlock Text="◇" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource QuietText}"/><Image Source="{Binding Cover}" Stretch="UniformToFill"/></Grid></Border>
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4"><TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Platform}" FontSize="12" Foreground="{StaticResource QuietText}"/></StackPanel>
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center" ToolTipService.ToolTip="{Binding AttentionDetail}"><Ellipse Width="6" Height="6" Fill="{Binding InstallBrush}"/><TextBlock Text="{Binding InstallState}" FontSize="12" Foreground="{Binding InstallBrush}"/></StackPanel>
            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center" ToolTipService.ToolTip="{Binding SteamSyncDetail}"><Ellipse Width="6" Height="6" Fill="{Binding StatusBrush}"/><TextBlock Text="{Binding SteamSyncStatus}" FontSize="12" Foreground="{Binding StatusBrush}"/></StackPanel>
            <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center" ToolTipService.ToolTip="{Binding ArtworkDetail}"><Ellipse Width="6" Height="6" Fill="{Binding ArtworkBrush}"/><TextBlock Text="{Binding ArtworkStatus}" FontSize="12" Foreground="{Binding ArtworkBrush}"/></StackPanel>
          </Grid>
        </DataTemplate></ListView.ItemTemplate>
      </ListView>
      <TextBlock Grid.Row="1" x:Name="EmptyState" Text="No games match these filters." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource QuietText}" Visibility="Collapsed"/>
    </Grid>
    <Grid Grid.Row="4" Margin="32,14,32,6" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Button x:Name="PrepareButton" Content="Prepare in Steam…" Tag="Prepare" Click="SelectionWorkflow_Click" Background="{StaticResource Accent}" Foreground="{StaticResource AppSurface}" FontWeight="SemiBold" IsEnabled="False"/>
      <Button Grid.Column="1" x:Name="LaunchButton" Content="Launch" Tag="Launch" Click="SelectionWorkflow_Click" IsEnabled="False"/>
      <Button Grid.Column="2" x:Name="ArtworkButton" Content="Artwork…" Tag="Artwork" Click="SelectionWorkflow_Click" IsEnabled="False"/>
      <Button Grid.Column="3" x:Name="SelectionMoreButton" Content="More" IsEnabled="False"/>
      <TextBlock Grid.Column="4" x:Name="SelectionSummary" Text="Check games to select them" Foreground="{StaticResource QuietText}" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12"/>
    </Grid>
    <Grid Grid.Row="5" Margin="32,0,32,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Footer" Text="Finding your library…" FontSize="11" Foreground="{StaticResource QuietText}" VerticalAlignment="Center"/><Button Grid.Column="1" x:Name="NoticeButton" Content="Scan details" Click="Notices_Click" Background="Transparent" BorderThickness="0" FontSize="11"/></Grid>
  </Grid>
</Window>
